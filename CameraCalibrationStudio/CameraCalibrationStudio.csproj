<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CameraCalibrationStudio</AssemblyName>
    <RootNamespace>CameraCalibrationStudio</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <Version>1.4.0</Version>
    <!-- The app has no localized UI text, so publishing WPF's satellite resource DLLs for
         every language (zh-Hans, zh-Hant, ja, ko, ...) is dead weight the installer would
         otherwise have to carry — this alone was most of the publish output's size. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <!-- The YOLOv8 weights are deliberately NOT bundled: they are Ultralytics' and AGPL-3.0, so
         shipping them would place that licence's obligations on this project. ModelStore fetches
         them to the user's app-data folder on first use instead. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.10.0.20241108" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

</Project>
