<Window x:Class="CameraCalibrationStudio.Views.MagicOptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magic — what to detect" Height="380" Width="380"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" AllowsTransparency="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBackground}" FontFamily="Segoe UI">
    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="✨ Magic — what should it look for?" Foreground="{StaticResource TextPrimary}" FontSize="14.5" FontWeight="SemiBold"/>
                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Every result is a candidate for you to review, rename or discard next — never written straight into the calibration."/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <CheckBox x:Name="YoloCheck" Content="Real object detection (YOLOv8)" IsChecked="True" Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,6"/>
                <TextBlock Text="A trained model bundled with the app — recognizes 80 categories by name: people, cars, chairs, bottles, animals and more. Falls back to a basic pedestrian detector if the model file is unavailable."
                           Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,10"/>

                <CheckBox x:Name="RefineOutlinesCheck" Content="Fit points to object outline" IsChecked="True" Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="24,0,0,6"/>
                <TextBlock Text="Traces each detected object's real silhouette instead of proposing a plain box. Falls back to the box wherever tracing isn't confident."
                           Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="42,0,0,10"/>

                <CheckBox x:Name="AnyObjectCheck" Content="Any object (outline-based, legacy)" IsChecked="False" Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,6"/>
                <TextBlock Text="Classical contour analysis — finds a coherent object silhouette of any shape and fits points to its actual outline. Useful as a fallback for things outside YOLO's 80 categories (custom fixtures, signage, etc.)."
                           Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,10"/>

                <CheckBox x:Name="CircularCheck" Content="Circular objects (legacy)" IsChecked="False" Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,6"/>
                <TextBlock Text="Off by default — rounded silhouettes in cluttered scenes (chair backs, cable loops) can still fool it. Turn on for frames with genuinely round objects like wheels, tables or plates, and review its results carefully."
                           Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource ToolButton}"/>
                <Button Content="Run Magic" Click="Run_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
