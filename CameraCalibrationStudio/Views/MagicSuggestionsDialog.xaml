<Window x:Class="CameraCalibrationStudio.Views.MagicSuggestionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magic — AI calibration suggestions" Height="560" Width="480"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" AllowsTransparency="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBackground}" FontFamily="Segoe UI">
    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="✨ Magic — AI calibration suggestions" Foreground="{StaticResource TextPrimary}" FontSize="14.5" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubtitleText" Foreground="{StaticResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Review each detection, pick a defined class or just type a name, then apply. Every applied region stays a normal, fully editable calibration object afterward."/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,6">
                <Button Content="Select all" Click="SelectAll_Click" Style="{StaticResource ToolButton}"/>
                <Button Content="Select none" Click="SelectNone_Click" Style="{StaticResource ToolButton}" Margin="6,0,0,0"/>
                <TextBlock x:Name="CountText" Foreground="{StaticResource TextSecondary}" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>

            <ListBox x:Name="SuggestionList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource TileBackground}" CornerRadius="6" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding Include, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,3,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DetectedLabel}" Foreground="{StaticResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{StaticResource TileBackgroundHover}" CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Source}" Foreground="{StaticResource TextSecondary}" FontSize="9.5"
                                                           ToolTip="Which detector produced this suggestion"/>
                                            </Border>
                                            <TextBlock Text="{Binding ConfidenceLabel}" Foreground="{StaticResource TextSecondary}" FontSize="10.5"
                                                       ToolTip="Detector confidence — always review before applying"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource InputBox}" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,4,0" ToolTip="Name for this region"/>
                                        <ComboBox Grid.Column="1" x:Name="ClassCombo" DisplayMemberPath="Name"
                                                  ItemsSource="{Binding ClassLibrary, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding SelectedClass, Mode=TwoWay}" Margin="4,0,0,0"
                                                  ToolTip="Optionally assign a defined class instead of a one-off name"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource ToolButton}"/>
                <Button x:Name="ApplyButton" Content="Apply selected" Click="Apply_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
