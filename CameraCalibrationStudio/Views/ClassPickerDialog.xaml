<Window x:Class="CameraCalibrationStudio.Views.ClassPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign Class" Height="420" Width="320"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" AllowsTransparency="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBackground}" FontFamily="Segoe UI"
        Deactivated="Window_Deactivated">
    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Text="Assign Calibration Class" Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource InputBox}" Margin="0,0,0,8"
                     TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>

            <ListBox x:Name="ClassList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ObjectListItem}"
                     MouseDoubleClick="ClassList_MouseDoubleClick" KeyDown="ClassList_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="10" Height="10" Fill="{Binding SwatchBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding ShapeLabel}" Foreground="{StaticResource TextSecondary}" FontSize="10.5" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,0,0,10"/>

                <!-- Inline "create new class" mini-form, hidden until requested -->
                <StackPanel x:Name="CreatePanel" Visibility="Collapsed" Margin="0,0,0,10">
                    <TextBlock Text="New Class" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="NewClassNameBox" Style="{StaticResource InputBox}" Margin="0,0,0,6"/>
                    <TextBlock Text="Preferred shape" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="NewClassShapeCombo" Margin="0,0,0,8" SelectedIndex="2">
                        <ComboBoxItem Content="Rectangle"/>
                        <ComboBoxItem Content="Square"/>
                        <ComboBoxItem Content="Polygon"/>
                        <ComboBoxItem Content="Line"/>
                        <ComboBoxItem Content="(none)"/>
                    </ComboBox>
                    <Button Content="Save &amp; Assign" Click="SaveAndAssign_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <Button x:Name="CreateNewButton" Content="+ Create New Class" Click="CreateNewButton_Click" Style="{StaticResource ToolButton}" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                <Button x:Name="CustomNameButton" Content="Type a custom name instead" Click="CustomName_Click" Style="{StaticResource ToolButton}" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource ToolButton}" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
