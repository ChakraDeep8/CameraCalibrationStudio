<Window x:Class="CameraCalibrationStudio.Views.BatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Apply" Height="560" Width="760" MinHeight="420" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock Text="Apply this camera's calibrated adjustments to a folder of related images." Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

            <TextBlock Text="Input folder" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
            <Grid Margin="0,2,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputFolderBox" Style="{StaticResource InputBox}"/>
                <Button Grid.Column="1" Content="Browse" Click="BrowseInputFolder_Click" Style="{StaticResource ToolButton}" Margin="6,0,0,0"/>
            </Grid>

            <TextBlock Text="Output folder" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
            <Grid Margin="0,2,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="OutputFolderBox" Style="{StaticResource InputBox}"/>
                <Button Grid.Column="1" Content="Browse" Click="BrowseOutputFolder_Click" Style="{StaticResource ToolButton}" Margin="6,0,0,0"/>
            </Grid>

            <TextBlock Text="OPERATIONS" Style="{StaticResource SectionLabel}"/>
            <CheckBox x:Name="UndistortCheck" Content="Undistort (uses saved Lens Calibration profile)" Foreground="{StaticResource TextPrimary}" Margin="0,4"/>
            <CheckBox x:Name="AdjustmentsCheck" Content="Apply current preview adjustments" Foreground="{StaticResource TextPrimary}" Margin="0,4" IsChecked="True"/>
            <TextBlock x:Name="AdjustmentsSummaryText" Foreground="{StaticResource TextSecondary}" FontSize="10.5" TextWrapping="Wrap" Margin="20,0,0,4"/>

            <CheckBox x:Name="ResizeCheck" Content="Resize" Foreground="{StaticResource TextPrimary}" Margin="0,8,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Width" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    <TextBox x:Name="ResizeWidthBox" Text="1024" Style="{StaticResource InputBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Height" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    <TextBox x:Name="ResizeHeightBox" Text="768" Style="{StaticResource InputBox}"/>
                </StackPanel>
            </Grid>

            <Button Content="Run Batch" Click="RunBatch_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,18,0,6"/>
            <ProgressBar x:Name="BatchProgress" Height="8" Minimum="0" Maximum="100" Value="0"/>
        </StackPanel>

        <Border Grid.Column="2" Background="{StaticResource TileBackground}" CornerRadius="8">
            <TextBox x:Name="BatchLogText" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                     IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" Margin="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5"/>
        </Border>
    </Grid>
</Window>
