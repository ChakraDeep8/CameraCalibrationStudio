<UserControl x:Class="CameraCalibrationStudio.Controls.RoiCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" Background="{StaticResource TileBackground}">
    <Border x:Name="Viewport" ClipToBounds="True" Background="Transparent" Focusable="True"
            MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
            MouseMove="Viewport_MouseMove"
            MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
            MouseRightButtonDown="Viewport_MouseRightButtonDown"
            MouseWheel="Viewport_MouseWheel"
            MouseLeave="Viewport_MouseLeave"
            PreviewKeyDown="Viewport_PreviewKeyDown"
            SizeChanged="Viewport_SizeChanged">
        <Grid x:Name="TransformRoot" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="Translate" X="0" Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Image x:Name="BackgroundImage" Stretch="Fill" SnapsToDevicePixels="True"/>
            <Canvas x:Name="ShapesCanvas" Background="Transparent"/>
        </Grid>
    </Border>
</UserControl>
